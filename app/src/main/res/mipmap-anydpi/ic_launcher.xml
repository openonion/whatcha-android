<?xml version="1.0" encoding="utf-8"?>
<!-- WeChat green with one white speech bubble: reads as "chat" to someone who only knows WeChat,
     without copying WeChat's own two-bubble logo. The dots are someone about to answer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_green" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
